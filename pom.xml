<project child.project.url.inherit.append.path="false" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.octopusden.octopus</groupId>
        <artifactId>octopus-parent</artifactId>
        <version>2.0.11</version>
    </parent>

    <groupId>org.octopusden.octopus.tools.wl</groupId>
    <artifactId>wl-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>Octopus White Labeling Tool</name>
    <description>White labeling validation tool: checks sources and distributions against
        white labeling rules and reports forbidden tokens, file names and content.
    </description>
    <url>https://github.com/octopusden/octopus-wl-tool</url>
    <packaging>pom</packaging>

    <!-- Inherited from octopus-parent, these would point at octopus-parent's own repository
         with the module path appended, so they are declared here. The enforcer rule
         require-central-metadata only checks that they are non-empty. -->
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:git://github.com/octopusden/octopus-wl-tool.git</connection>
        <developerConnection>scm:git:ssh://github.com:octopusden/octopus-wl-tool.git</developerConnection>
        <url>https://github.com/octopusden/octopus-wl-tool/tree/main</url>
    </scm>

    <modules>
        <module>wl-tool</module>
        <module>validation</module>
    </modules>

    <properties>
        <kotlin.version>1.8.22</kotlin.version>
        <jackson.version>2.18.9</jackson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-jdk8</artifactId>
                <version>${kotlin.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>5.8.2</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>5.8.2</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-params</artifactId>
                <version>5.8.2</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <dependencies>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                    <executions>
                        <execution>
                            <id>compile</id>
                            <phase>compile</phase>
                            <goals>
                                <goal>compile</goal>
                            </goals>
                            <configuration>
                                <sourceDirs>
                                    <source>src/main/kotlin</source>
                                </sourceDirs>
                            </configuration>
                        </execution>
                        <execution>
                            <id>test-compile</id>
                            <phase>test-compile</phase>
                            <goals>
                                <goal>test-compile</goal>
                            </goals>
                            <configuration>
                                <sourceDirs>
                                    <source>src/test/kotlin</source>
                                    <source>src/test/resources</source>
                                </sourceDirs>
                            </configuration>
                        </execution>
                    </executions>
                    <configuration>
                        <jvmTarget>1.8</jvmTarget>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/main/kotlin</source>
                            </sources>
                        </configuration>
                    </execution>
                    <!-- kotlin-maven-plugin compiles src/test/kotlin through its own sourceDirs,
                         which never reach the Maven model - so the linters would not see the
                         tests at all. -->
                    <execution>
                        <id>add-test-kotlin-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/test/kotlin</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
                <plugin>
                    <groupId>org.jetbrains.dokka</groupId>
                    <artifactId>dokka-maven-plugin</artifactId>
                    <version>1.9.0</version>
                    <configuration>
                        <sourceDirectories>
                            <dir>${project.basedir}/src/main/kotlin</dir>
                        </sourceDirectories>
                    </configuration>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals>
                                <goal>javadocJar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Linters are not in the default build: the release runs on JDK 8 (see
             .github/workflows/release.yml) and these plugins need a newer JVM. The
             Quality Gates workflow activates this profile on JDK 11. -->
        <profile>
            <id>quality</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.gantsign.maven</groupId>
                        <artifactId>ktlint-maven-plugin</artifactId>
                        <version>3.7.1</version>
                        <executions>
                            <execution>
                                <id>ktlint</id>
                                <phase>process-test-sources</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Mutation testing, on demand only:
                         mvn -P quality org.pitest:pitest-maven:mutationCoverage
                         Not bound to a phase and not a gate - see README. -->
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.17.4</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.1</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <!-- The validators and the filters: predicates and thresholds,
                                     where line coverage says the least. Report rendering,
                                     config holders and IO glue are left out on purpose. -->
                                <param>org.octopusden.octopus.tools.wl.validation.validator.*</param>
                                <param>org.octopusden.octopus.util.FileFilter*</param>
                                <param>org.octopusden.octopus.components.automation.task.WLSourceValidator*</param>
                                <param>org.octopusden.octopus.components.automation.task.PrintableRuns*</param>
                                <param>org.octopusden.octopus.components.automation.task.TextTokenHandler*</param>
                                <param>org.octopusden.octopus.tools.wl.PatternCalculator*</param>
                            </targetClasses>
                            <targetTests>
                                <param>org.octopusden.octopus.*</param>
                            </targetTests>
                            <!-- DEFAULTS minus VOID_METHOD_CALLS. In Kotlin that mutator
                                 mostly removes calls the compiler generated - Intrinsics
                                 null checks, closeFinally in `use` blocks - plus logging,
                                 and those mutants are unkillable by design: 73 of 199
                                 survivors in the first run were exactly that. The paid
                                 arcmutate Kotlin plugin filters more; this needs no licence. -->
                            <mutators>
                                <mutator>CONDITIONALS_BOUNDARY</mutator>
                                <mutator>INCREMENTS</mutator>
                                <mutator>INVERT_NEGS</mutator>
                                <mutator>MATH</mutator>
                                <mutator>NEGATE_CONDITIONALS</mutator>
                                <mutator>EMPTY_RETURNS</mutator>
                                <mutator>FALSE_RETURNS</mutator>
                                <mutator>TRUE_RETURNS</mutator>
                                <mutator>NULL_RETURNS</mutator>
                                <mutator>PRIMITIVE_RETURNS</mutator>
                            </mutators>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <failWhenNoMutations>false</failWhenNoMutations>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.12</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <!-- prepare-package, not verify: the CI job runs `mvn package`,
                                 and a coverage gate that the gate job never reaches is no gate. -->
                            <execution>
                                <id>report</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>check</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <!-- 70%: the aggregated line-coverage floor
                                                         gradle-quality-plugin uses. Today the
                                                         modules sit at 93% and 82%. -->
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.70</minimum>
                                                </limit>
                                                <limit>
                                                    <!-- Branches matter more than lines for code
                                                         that is mostly predicates and thresholds:
                                                         a line runs with either outcome of an
                                                         `if`, a branch does not. 60% because
                                                         wl-tool sits at 64% today - raise it as
                                                         the tests pin down more cases. -->
                                                    <counter>BRANCH</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.60</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.github.ozsie</groupId>
                        <artifactId>detekt-maven-plugin</artifactId>
                        <version>1.23.8</version>
                        <executions>
                            <execution>
                                <id>detekt</id>
                                <phase>process-test-sources</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <buildUponDefaultConfig>true</buildUponDefaultConfig>
                            <config>${maven.multiModuleProjectDirectory}/detekt.yml</config>
                            <!-- Baseline holds the violations that existed when detekt was
                                 introduced; new code must not add entries to it. Regenerate
                                 with: mvn -P quality generate-test-sources detekt:create-baseline -->
                            <baseline>${project.basedir}/detekt-baseline.xml</baseline>
                            <!-- src/test/resources holds .kt files that are test input for the
                                 white labeling validators, not code of this project. -->
                            <excludes>**/resources/**</excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
